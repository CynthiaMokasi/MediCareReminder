<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_welcome">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/txtAddMedicationBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Medications"
            android:textColor="@color/primary_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Add Medication"
            android:textColor="@color/dark_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Create a reminder for your medication"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etMedicationName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_input"
            android:hint="Medication Name"
            android:inputType="text"
            android:textColor="@color/dark_navy"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etDosage"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Dosage e.g. 500 mg"
            android:inputType="text"
            android:textColor="@color/dark_navy"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etMedicationTime"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Reminder Time e.g. 08:00 AM"
            android:inputType="time"
            android:textColor="@color/dark_navy"
            android:textColorHint="@color/text_secondary" />

        <EditText
            android:id="@+id/etFrequency"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Frequency e.g. Every day"
            android:inputType="text"
            android:textColor="@color/dark_navy"
            android:textColorHint="@color/text_secondary" />

        <Button
            android:id="@+id/btnSaveMedication"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_primary_button"
            android:text="Save Medication"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>